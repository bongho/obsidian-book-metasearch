{
	"name": "obsidian-book-metasearch",
	"version": "1.2.2",
	"description": "Book note maker with metasearch across Aladin, Kakao, Google Books, and Open Library.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"verify": "npm test && npm run build && npm run lint"
	},
	"keywords": [
		"obsidian-plugin",
		"book",
		"aladin",
		"kakao",
		"google-books",
		"open-library",
		"metasearch"
	],
	"license": "MIT",
	"author": "BongHo Lee",
	"repository": {
		"type": "git",
		"url": "https://github.com/bongho/obsidian-book-metasearch.git"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^26.1.2",
		"@vitest/coverage-v8": "^2.1.9",
		"esbuild": "0.28.1",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"globals": "^17.9.0",
		"happy-dom": "^20.11.1",
		"jiti": "^2.6.1",
		"obsidian": "^1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.66.0",
		"vitest": "^2.1.9"
	}
}
